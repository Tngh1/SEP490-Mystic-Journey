  m_Script: {fileID: 11500000, guid: 10a2c1cd755fc61478141a6d0dcd1e9a, type: 3}
  m_Name: DefaultLoadingTips
  m_EditorClassIdentifier: Assembly-CSharp::LoadingTipDatabase
  tips:
  - "Qu\xE1i hi\u1EBFm th\u01B0\u1EDDng r\u01A1i nhi\u1EC1u ph\u1EA7n th\u01B0\u1EDFng
    gi\xE1 tr\u1ECB h\u01A1n."
  - "\r\nN\xE2ng c\u1EA5p v\u0169 kh\xED gi\xFAp t\u0103ng s\xE1t th\u01B0\u01A1ng
    \u0111\xE1ng k\u1EC3.\r\n"
  - "\r\nM\u1ED9t s\u1ED1 r\u01B0\u01A1ng ch\u1EC9 xu\u1EA5t hi\u1EC7n sau khi ti\xEAu
    di\u1EC7t to\xE0n b\u1ED9 qu\xE1i.\r\n"
  - "\r\nBoss c\xF3 th\u1EC3 \u0111\u1ED5i pattern khi c\xF2n d\u01B0\u1EDBi 50%
    m\xE1u."
  - "\r\nTrang b\u1ECB hi\u1EBFm c\xF3 ch\u1EC9 s\u1ED1 ph\u1EE5 m\u1EA1nh h\u01A1n
    trang b\u1ECB th\u01B0\u1EDDng."
